export async function initializeCanvasRuntime(
  host: HTMLElement,
  options: EndlessCanvasRuntimeOptions,
): Promise<CanvasRuntime> {
  const {
    engine,
    document: documentState,
    algorithms,
    ui,
  } = options;

  // ---------------------------------------------------------------------------
  // Scene
  // ---------------------------------------------------------------------------

  const scene = await CanvasScene.create(host);

  // ---------------------------------------------------------------------------
  // Document
  // ---------------------------------------------------------------------------

  documentState.hydrate(initialCards, []);

  // ---------------------------------------------------------------------------
  // Core controllers
  // ---------------------------------------------------------------------------

  const selection =
    new CanvasSelectionController();

  const preferences =
    new CanvasPreferencesController(
      options.preferences,
    );

  const spatialIndex =
    new CanvasSpatialIndex({
      getCard: (id) =>
        documentState.cards.find(
          (card) => card.id === id,
        ),

      getLink: (id) =>
        documentState.links.find(
          (link) => link.id === id,
        ),

      cards: () =>
        documentState.cards,

      links: () =>
        documentState.links,
    });

  // ---------------------------------------------------------------------------
  // History
  // ---------------------------------------------------------------------------

  const captureSnapshot = (): Snapshot => ({
    cards: cloneCards(
      documentState.cards,
    ),

    links: structuredClone(
      documentState.links,
    ),

    selectedCardId:
      selection.primaryCardId ?? "",

    selectedCardIds: [
      ...selection.cards,
    ],

    selectedLinkIds: [
      ...selection.links,
    ],

    selectedElementIds: [
      ...selection.elements,
    ],

    mode:
      boardManager?.mode ?? "board",
  });

  const history =
    new CanvasHistoryController<Snapshot>({
      capture: captureSnapshot,

      restore: (snapshot) => {
        documentState.setCards(
          snapshot.cards,
        );

        documentState.setLinks(
          snapshot.links,
        );

        selection.clearAll();

        selection.selectCards(
          snapshot.selectedCardIds,
        );

        for (
          const id of
          snapshot.selectedLinkIds
        ) {
          selection.selectLink(
            id,
            true,
          );
        }

        selection.selectElements(
          snapshot.selectedElementIds,
        );

        spatialIndex.invalidateAll();

        renderer?.render();
      },

      onChange: () => {
        renderer?.render();
      },
    });

  // ---------------------------------------------------------------------------
  // Clipboard
  // ---------------------------------------------------------------------------

  const clipboard =
    new CanvasClipboard();

  // ---------------------------------------------------------------------------
  // Persistence
  // ---------------------------------------------------------------------------

  let currentBoard:
    | CanvasBoardDocument
    | null = null;

  const persistence =
    new CanvasPersistence({
      store: {
        async loadBoards() {
          const result =
            await loadCanvasBoards();

          return result.boards;
        },

        async loadBoard(boardId) {
          const stored =
            await loadCanvasStore(
              boardId,
            );

          const cards =
            normalizeLoadedCards(
              stored.cards,
            );

          const links =
            normalizeLoadedLinks(
              stored.links,
              cards,
            );

          return {
            id:
              stored.boardId ??
              boardId,

            name:
              stored.name ??
              "Untitled Canvas",

            cards,
            links,
          };
        },

        async saveBoard(board) {
          documentState.commit();

          await documentState.flushSync();
        },

        async createBoard(name) {
          return createCanvasBoard(
            name,
          );
        },

        async renameBoard(
          boardId,
          name,
        ) {
          await updateCanvasBoardName(
            boardId,
            name,
          );
        },

        async duplicateBoard(
          boardId,
        ) {
          // Move your existing duplicateCanvas()
          // implementation here.
          throw new Error(
            "duplicateBoard not implemented",
          );
        },

        async deleteBoard(
          boardId,
        ) {
          await deleteCanvasBoard(
            boardId,
          );
        },
      },

      getCurrentBoard: () =>
        currentBoard,

      onError: (error) => {
        console.warn(
          "Failed to save canvas.",
          error,
        );
      },
    });

  // ---------------------------------------------------------------------------
  // Board manager
  // ---------------------------------------------------------------------------

  const boardManager =
    new CanvasBoardManager({
      persistence,

      onBoardChanged: (
        board,
      ) => {
        currentBoard = board;

        documentState.hydrate(
          board.cards,
          board.links,
        );

        selection.clearAll();
        spatialIndex.invalidateAll();

        preferences.activate(
          board.id,
        );

        renderer?.render();
      },

      onBoardsChanged: (
        boards,
      ) => {
        // Pass into your UI controller here.
        //
        // ui.updateBoards(boards);
      },
    });

  // ---------------------------------------------------------------------------
  // Text editor
  // ---------------------------------------------------------------------------

  const textEditor =
    new CanvasTextEditor({
      getElement: (
        cardId,
        elementId,
      ) => {
        const card =
          spatialIndex.getCard(
            cardId,
          );

        return card?.elements.find(
          (element) =>
            element.id ===
            elementId,
        );
      },

      updateElementText: (
        cardId,
        elementId,
        text,
      ) => {
        const card =
          spatialIndex.getCard(
            cardId,
          );

        const element =
          card?.elements.find(
            (candidate) =>
              candidate.id ===
              elementId,
          );

        if (
          !card ||
          element?.type !== "text"
        ) {
          return;
        }

        element.text = text;

        spatialIndex.markElementsDirty(
          cardId,
        );
      },

      beginHistory: () =>
        history.begin(),

      commitHistory: () =>
        history.commit(),

      cancelHistory: () =>
        history.cancel(),

      refresh: () =>
        renderer?.render(),

      scheduleSave: () =>
        persistence.scheduleSave(),
    });

  // ---------------------------------------------------------------------------
  // Board controller
  // ---------------------------------------------------------------------------

  const boardController =
    new CanvasBoardController({
      scene,

      selection,

      getCard: (id) =>
        spatialIndex.getCard(id),

      beginUndoGroup: () =>
        history.begin(),

      commit: () =>
        history.commit(),

      addLink: (link) => {
        documentState.links.push(
          link,
        );
      },

      registerLink: (id) =>
        spatialIndex.registerLink(
          id,
        ),

      refresh: () =>
        renderer?.render(),

      refreshNavigation: () =>
        renderer?.render(),

      syncToolbar: () => {
        // Move the old toolbar synchronization
        // call here.
      },

      scheduleSave: () =>
        persistence.scheduleSave(),

      cardCenter,

      openImagePicker: () =>
        ui.slots().imageFileInput.click(),
    });

  // ---------------------------------------------------------------------------
  // Detail controller
  // ---------------------------------------------------------------------------

  const detailController =
    new CanvasDetailController({
      scene,

      selection,

      clipboard,

      activeCard: () => {
        const id =
          selection
